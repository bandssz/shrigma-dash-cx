-- SOURCE ONLY. Root must bind an authentic, separate private admission before any execution.
-- Snapshot/envelope and every source body stay in original DB/RAM; never log/output them.
DO $own_recovery$
DECLARE
 e jsonb:=current_setting('shrigma.private_own_recovery_envelope',true)::jsonb;
 plan jsonb:=__PLAN_JSON_LITERAL__::jsonb;
 public_pins jsonb:=__PUBLIC_FUNCTION_PINS_LITERAL__::jsonb;
 admission jsonb;before_state jsonb;after_state jsonb;target jsonb;original_state jsonb;
 at timestamptz:=clock_timestamp();item jsonb;ctx jsonb;contexts jsonb:='{}'::jsonb;
 cid integer;changed integer;total_changed integer:=0;fn record;
BEGIN
 IF jsonb_typeof(e) IS DISTINCT FROM 'object' OR e->'plan' IS DISTINCT FROM plan
 OR jsonb_typeof(e->'snapshot') IS DISTINCT FROM 'object'
 OR jsonb_typeof(e->'privateAdmission') IS DISTINCT FROM 'object' THEN
  RAISE EXCEPTION 'OWN_RECOVERY_PRIVATE_ADMISSION_REQUIRED'; END IF;
 admission:=e->'privateAdmission';
 -- The trusted original owner/CURRENT/binding/source/quiescence checks are Root callbacks.
 -- These references only bind the exact admitted attempt. They never manufacture authority.
 IF admission->>'operationId' IS DISTINCT FROM plan->>'operationId'
 OR admission->>'purpose' IS DISTINCT FROM plan->>'admissionPurpose'
 OR admission->>'stage' IS DISTINCT FROM plan->>'stage'
 OR admission->'candidate' IS DISTINCT FROM plan->'candidate'
 OR admission->>'admissionSha256' IS DISTINCT FROM plan#>>'{privateReferences,admission,sha256}'
 OR admission->>'snapshotSha256' IS DISTINCT FROM plan#>>'{privateReferences,snapshot,sha256}'
 OR admission->>'restoreSha256' IS DISTINCT FROM plan#>>'{privateReferences,restore,sha256}'
 OR admission->>'quiescenceSha256' IS DISTINCT FROM plan#>>'{privateReferences,quiescence,sha256}'
 OR admission->>'bindingSha256' IS DISTINCT FROM plan#>>'{privateReferences,binding,sha256}'
 OR admission->>'actor' IS NULL OR length(admission->>'actor') NOT BETWEEN 1 AND 200
 OR admission->>'checkedAt' IS NULL OR admission->>'expiresAt' IS NULL
 OR NOT isfinite((admission->>'checkedAt')::timestamptz)
 OR NOT isfinite((admission->>'expiresAt')::timestamptz)
 OR (admission->>'checkedAt')::timestamptz>at OR (admission->>'expiresAt')::timestamptz<=at
 OR (admission->>'expiresAt')::timestamptz>(admission->>'checkedAt')::timestamptz+interval '5 minutes' THEN
  RAISE EXCEPTION 'OWN_RECOVERY_PRIVATE_ADMISSION_MISMATCH'; END IF;
 IF current_database()<>'listmonk' OR current_setting('server_version_num')::integer<>170010
 OR current_setting('transaction_isolation')<>'read committed'
 OR current_setting('TimeZone')<>'Etc/UTC' OR session_user IS DISTINCT FROM current_user
 OR current_setting('statement_timeout')::interval<>interval '5 seconds'
 OR current_setting('lock_timeout')::interval<>interval '500 milliseconds' THEN
  RAISE EXCEPTION 'OWN_RECOVERY_ORIGINAL_BOUNDARY_REFUSED'; END IF;
 -- Same deployment -> advisory lease -> lease -> selection -> control order as original.
 LOCK TABLE crm_audience_v2.regular_worker_deployment IN ACCESS EXCLUSIVE MODE;
 PERFORM pg_advisory_xact_lock(hashtextextended('crm-audience-v2-regular-worker-lease',0));
 PERFORM 1 FROM crm_audience_v2.regular_worker_lease WHERE singleton FOR UPDATE;
 PERFORM 1 FROM crm_audience_v2.selection_runtime WHERE singleton FOR SHARE;
 LOCK TABLE crm_audience_v2.regular_delivery_campaign IN SHARE ROW EXCLUSIVE MODE;
 PERFORM 1 FROM public.campaigns WHERE id IN(171,172,173,174) ORDER BY id FOR UPDATE;
 PERFORM 1 FROM crm_audience_v2.campaign_binding WHERE campaign_id IN(171,172,174) ORDER BY campaign_id FOR SHARE;
 LOCK TABLE public.crm_ab_arm_v2 IN SHARE MODE;
 LOCK TABLE public.shrigma_email_dispatch IN SHARE ROW EXCLUSIVE MODE;
 __SNAPSHOT_SELECT__ INTO before_state;
 IF before_state IS DISTINCT FROM e->'snapshot' THEN RAISE EXCEPTION 'OWN_RECOVERY_SNAPSHOT_DRIFT'; END IF;
 IF before_state->'mutationTriggers' IS DISTINCT FROM '[]'::jsonb
 OR jsonb_array_length(before_state->'campaignGuard')<>3
 OR before_state->'abArms' IS DISTINCT FROM '[]'::jsonb
 OR EXISTS(SELECT 1 FROM jsonb_array_elements(before_state->'campaignGuard') g
   WHERE g->>'enabled' IS DISTINCT FROM 'O' OR NOT EXISTS(
    SELECT 1 FROM (VALUES
      ('crm_audience_v2.campaign_send_guard()',27),
      ('public.shrigma_campaign_guard()',31),('public.crm_ab_campaign_guard_v2()',27)) expected(signature,type)
    WHERE g->>'function'=pg_catalog.to_regprocedure(expected.signature)::oid::text
     AND g->>'function'=(before_state->'functionMetadata'->expected.signature->>'oid')
     AND (g->>'type')::integer=expected.type))
 OR EXISTS(SELECT 1 FROM (VALUES ('crm_audience_v2.campaign_send_guard()'),
    ('public.shrigma_campaign_guard()'),('public.crm_ab_campaign_guard_v2()')) expected(signature)
   WHERE (SELECT count(*) FROM jsonb_array_elements(before_state->'campaignGuard') g
     WHERE g->>'function'=pg_catalog.to_regprocedure(expected.signature)::oid::text)<>1) THEN
  RAISE EXCEPTION 'OWN_RECOVERY_TRIGGER_OR_AB_REFUSED'; END IF;
 FOR fn IN SELECT key,value FROM jsonb_each(before_state->'functionMetadata') LOOP
  IF fn.value='null'::jsonb OR NOT EXISTS(SELECT 1 FROM jsonb_array_elements(public_pins) p
   WHERE p->>'signature'=fn.key AND p->>'md5'=md5(fn.value->>'prosrc')) THEN
   RAISE EXCEPTION 'OWN_RECOVERY_FUNCTION_PIN_REFUSED'; END IF;
 END LOOP;
 IF (SELECT count(*) FROM jsonb_each(before_state->'functionMetadata'))<>12
 OR EXISTS(SELECT 1 FROM jsonb_each(before_state->'relationMetadata') r
    WHERE r.value->>'oid' IS NULL OR r.value->>'kind' NOT IN('r','p')
      OR r.value->>'rls' IS DISTINCT FROM 'false' OR r.value->>'forceRls' IS DISTINCT FROM 'false') THEN
  RAISE EXCEPTION 'OWN_RECOVERY_METADATA_REFUSED'; END IF;
 IF before_state#>>'{deployment,enabled}' IS DISTINCT FROM 'true'
 OR before_state#>>'{deployment,database_role}' IS DISTINCT FROM session_user::text
 OR before_state#>>'{deployment,query_sha256}' IS DISTINCT FROM plan#>>'{candidate,querySha256}'
 OR before_state#>>'{deployment,runtime_sha256}' IS DISTINCT FROM plan#>>'{candidate,runtimeSha256}'
 OR before_state#>>'{deployment,approved_at}' IS NULL
 OR NOT isfinite((before_state#>>'{deployment,approved_at}')::timestamptz)
 OR (before_state#>>'{deployment,approved_at}')::timestamptz>at
 OR jsonb_array_length(before_state->'controls')<>3
 OR jsonb_array_length(before_state->'campaigns')<>4
 OR before_state->'dispatch' IS DISTINCT FROM '[]'::jsonb THEN
  RAISE EXCEPTION 'OWN_RECOVERY_SCOPE_OR_ATTEMPT_REFUSED'; END IF;
 IF (SELECT jsonb_agg((c->>'campaign_id')::integer ORDER BY (c->>'campaign_id')::integer)
      FROM jsonb_array_elements(before_state->'controls') c) IS DISTINCT FROM '[171,172,174]'::jsonb
 OR EXISTS(SELECT 1 FROM crm_audience_v2.regular_delivery_campaign r
    JOIN public.campaigns c ON c.id=r.campaign_id CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND r.enabled
      AND r.worker_sha256 IN(plan#>>'{candidate,oldWorkerSha256}',plan#>>'{candidate,newWorkerSha256}')
      AND r.runtime_sha256=d.runtime_sha256
      AND c.status::text IN('running','scheduled','paused') AND r.campaign_id NOT IN(171,172,174)) THEN
  RAISE EXCEPTION 'OWN_RECOVERY_OWNED_SET_DRIFT'; END IF;
 FOR cid IN SELECT unnest(ARRAY[171,172,174]) LOOP
  IF NOT EXISTS(SELECT 1 FROM crm_audience_v2.regular_delivery_campaign r
    JOIN public.campaigns c ON c.id=r.campaign_id
    JOIN LATERAL crm_audience_v2.campaign_binding_effective(c.id) b ON true
    WHERE r.campaign_id=cid AND r.enabled
      AND c.type::text='regular' AND c.messenger='email'
      AND c.attribs#>>'{crm,policy}'='crm-campaign-v1'
      AND c.attribs#>>'{crm,brand}'=b.brand
      AND r.binding_version=b.binding_version AND r.binding_hash=b.binding_hash
      AND r.runtime_sha256=plan#>>'{candidate,runtimeSha256}'
      AND r.acknowledged_sent=0 AND r.acknowledged_subscriber_id=0
      AND c.sent=0 AND c.last_subscriber_id=0
      AND r.material IS NOT DISTINCT FROM crm_audience_v2.regular_delivery_material(cid)) THEN
   RAISE EXCEPTION 'OWN_RECOVERY_CONTROL_BINDING_MATERIAL_REFUSED'; END IF;
 END LOOP;
 IF NOT EXISTS(SELECT 1 FROM public.campaigns WHERE id=172 AND status::text='scheduled')
 OR NOT EXISTS(SELECT 1 FROM public.campaigns WHERE id=173 AND status::text='scheduled'
    AND NOT EXISTS(SELECT 1 FROM crm_audience_v2.campaign_binding_effective(173))) THEN
  RAISE EXCEPTION 'OWN_RECOVERY_FUTURE_OR_LEGACY_DRIFT'; END IF;
 IF plan->>'stage' IN('repair-identity','restore-before-heartbeat') THEN
  IF before_state#>>'{lease,instance_id}' IS NULL
  OR before_state#>>'{lease,instance_id}'='00000000-0000-0000-0000-000000000000'
  OR before_state#>>'{lease,expires_at}' IS NULL OR before_state#>>'{lease,heartbeat_at}' IS NULL
  OR NOT isfinite((before_state#>>'{lease,heartbeat_at}')::timestamptz)
  OR NOT isfinite((before_state#>>'{lease,expires_at}')::timestamptz)
  OR (before_state#>>'{lease,expires_at}')::timestamptz>clock_timestamp()
  OR (before_state#>>'{lease,heartbeat_at}')::timestamptz>clock_timestamp()
  OR before_state#>>'{lease,worker_sha256}' IS DISTINCT FROM plan#>>'{candidate,oldWorkerSha256}'
  OR before_state#>>'{lease,runtime_sha256}' IS DISTINCT FROM plan#>>'{candidate,runtimeSha256}'
  OR before_state#>>'{lease,database_role}' IS DISTINCT FROM before_state#>>'{deployment,database_role}'
  OR EXISTS(SELECT 1 FROM public.campaigns WHERE id IN(171,174) AND status::text<>'paused') THEN
   RAISE EXCEPTION 'OWN_RECOVERY_LEASE_OR_PAUSE_REFUSED'; END IF;
 END IF;
 target:=before_state;
 IF plan->>'stage'='repair-identity' THEN
  IF before_state#>>'{lease,suspended}' IS DISTINCT FROM 'true'
  OR before_state#>>'{lease,suspension_reason}' IS DISTINCT FROM 'competing_instance'
  OR before_state#>>'{deployment,worker_sha256}' IS DISTINCT FROM plan#>>'{candidate,oldWorkerSha256}'
  OR EXISTS(SELECT 1 FROM crm_audience_v2.regular_delivery_campaign
    WHERE campaign_id IN(171,172,174) AND worker_sha256 IS DISTINCT FROM plan#>>'{candidate,oldWorkerSha256}')
  OR EXISTS(SELECT 1 FROM crm_audience_v2.regular_delivery_campaign
    WHERE campaign_id IN(171,174) AND NOT suspended)
  OR EXISTS(SELECT 1 FROM crm_audience_v2.regular_delivery_campaign WHERE campaign_id=172 AND suspended) THEN
   RAISE EXCEPTION 'OWN_RECOVERY_COLLISION_SCOPE_REFUSED'; END IF;
  UPDATE crm_audience_v2.regular_worker_deployment SET worker_sha256=plan#>>'{candidate,newWorkerSha256}' WHERE singleton;
  GET DIAGNOSTICS changed=ROW_COUNT;IF changed<>1 THEN RAISE EXCEPTION 'OWN_RECOVERY_DEPLOYMENT_CARDINALITY'; END IF;
  UPDATE crm_audience_v2.regular_delivery_campaign SET worker_sha256=plan#>>'{candidate,newWorkerSha256}',
    suspended=CASE WHEN campaign_id IN(171,174) THEN false ELSE suspended END WHERE campaign_id IN(171,172,174);
  GET DIAGNOSTICS changed=ROW_COUNT;IF changed<>3 THEN RAISE EXCEPTION 'OWN_RECOVERY_CONTROL_CARDINALITY'; END IF;
  UPDATE crm_audience_v2.regular_worker_lease SET suspended=false,suspension_reason=NULL WHERE singleton;
  GET DIAGNOSTICS changed=ROW_COUNT;IF changed<>1 THEN RAISE EXCEPTION 'OWN_RECOVERY_LEASE_CARDINALITY'; END IF;
  target:=jsonb_set(target,'{deployment,worker_sha256}',plan#>'{candidate,newWorkerSha256}');
  target:=jsonb_set(target,'{lease,suspended}','false'::jsonb);
  target:=jsonb_set(target,'{lease,suspension_reason}','null'::jsonb);
  SELECT jsonb_agg(c||jsonb_build_object('worker_sha256',plan#>>'{candidate,newWorkerSha256}',
    'suspended',CASE WHEN (c->>'campaign_id')::integer IN(171,174) THEN false ELSE (c->>'suspended')::boolean END)
    ORDER BY (c->>'campaign_id')::integer) INTO item FROM jsonb_array_elements(target->'controls') c;
  target:=jsonb_set(target,'{controls}',item);
 ELSIF plan->>'stage'='resume-after-heartbeat' THEN
  IF before_state#>>'{deployment,worker_sha256}' IS DISTINCT FROM plan#>>'{candidate,newWorkerSha256}'
  OR before_state#>>'{lease,worker_sha256}' IS DISTINCT FROM plan#>>'{candidate,newWorkerSha256}'
  OR before_state#>>'{lease,runtime_sha256}' IS DISTINCT FROM plan#>>'{candidate,runtimeSha256}'
  OR before_state#>>'{lease,database_role}' IS DISTINCT FROM before_state#>>'{deployment,database_role}'
  OR before_state#>>'{lease,suspended}' IS DISTINCT FROM 'false'
  OR before_state#>>'{lease,suspension_reason}' IS NOT NULL
  OR before_state#>>'{lease,instance_id}' IS NULL
  OR before_state#>>'{lease,instance_id}'='00000000-0000-0000-0000-000000000000'
  OR before_state#>>'{lease,heartbeat_at}' IS NULL OR before_state#>>'{lease,expires_at}' IS NULL
  OR NOT isfinite((before_state#>>'{lease,heartbeat_at}')::timestamptz)
  OR NOT isfinite((before_state#>>'{lease,expires_at}')::timestamptz)
  OR (before_state#>>'{lease,heartbeat_at}')::timestamptz>clock_timestamp()
  OR (before_state#>>'{lease,expires_at}')::timestamptz<=clock_timestamp()
  OR before_state#>>'{selectionRuntime,enabled}' IS DISTINCT FROM 'true'
  OR before_state#>>'{selectionRuntime,candidate_query_sha256}' IS DISTINCT FROM plan#>>'{candidate,querySha256}'
  OR before_state#>>'{selectionRuntime,verified_at}' IS NULL
  OR NOT isfinite((before_state#>>'{selectionRuntime,verified_at}')::timestamptz)
  OR (before_state#>>'{selectionRuntime,verified_at}')::timestamptz>clock_timestamp()
  OR (before_state#>>'{selectionRuntime,verified_at}')::timestamptz<clock_timestamp()-interval '5 minutes'
  OR EXISTS(SELECT 1 FROM crm_audience_v2.regular_delivery_campaign WHERE campaign_id IN(171,172,174)
    AND (suspended OR worker_sha256 IS DISTINCT FROM plan#>>'{candidate,newWorkerSha256}'))
  OR EXISTS(SELECT 1 FROM public.campaigns WHERE id IN(171,174) AND status::text<>'paused') THEN
   RAISE EXCEPTION 'OWN_RECOVERY_REAL_HEARTBEAT_REQUIRED'; END IF;
  -- Root binds the separately acknowledged stage-one handoff in this private admission.
  IF admission->>'identityCommitAcknowledgedAt' IS NULL OR admission->>'priorLeaseInstanceId' IS NULL
  OR NOT isfinite((admission->>'identityCommitAcknowledgedAt')::timestamptz)
  OR (admission->>'identityCommitAcknowledgedAt')::timestamptz>at
  OR (before_state#>>'{lease,heartbeat_at}')::timestamptz<(admission->>'identityCommitAcknowledgedAt')::timestamptz
  OR before_state#>>'{lease,instance_id}' IS NOT DISTINCT FROM admission->>'priorLeaseInstanceId'
  OR (before_state#>>'{lease,expires_at}')::timestamptz IS DISTINCT FROM
     (before_state#>>'{lease,heartbeat_at}')::timestamptz+interval '60 seconds' THEN
   RAISE EXCEPTION 'OWN_RECOVERY_REAL_HANDOFF_REQUIRED'; END IF;
  FOREACH cid IN ARRAY ARRAY[171,174] LOOP
   ctx:=crm_audience_v2.selection_worker_context(cid);
   IF ctx IS NULL OR ctx->'bound' IS DISTINCT FROM 'true'::jsonb THEN RAISE EXCEPTION 'OWN_RECOVERY_CONTEXT_REQUIRED'; END IF;
   contexts:=contexts||jsonb_build_object(cid::text,ctx);
  END LOOP;
  UPDATE public.campaigns SET status='scheduled' WHERE id IN(171,174) AND status::text='paused';
  GET DIAGNOSTICS changed=ROW_COUNT;IF changed<>2 THEN RAISE EXCEPTION 'OWN_RECOVERY_RESUME_CARDINALITY'; END IF;
  FOREACH cid IN ARRAY ARRAY[171,174] LOOP
   IF contexts->cid::text IS DISTINCT FROM crm_audience_v2.selection_worker_context(cid) THEN
    RAISE EXCEPTION 'OWN_RECOVERY_FINAL_CONTEXT_DRIFT'; END IF;
  END LOOP;
  IF (SELECT expires_at<=clock_timestamp() FROM crm_audience_v2.regular_worker_lease WHERE singleton) THEN
   RAISE EXCEPTION 'OWN_RECOVERY_FINAL_LEASE_EXPIRED'; END IF;
  SELECT jsonb_agg(c||CASE WHEN (c->>'id')::integer IN(171,174) THEN jsonb_build_object('status','scheduled')
    ELSE '{}'::jsonb END ORDER BY (c->>'id')::integer) INTO item FROM jsonb_array_elements(target->'campaigns') c;
  target:=jsonb_set(target,'{campaigns}',item);
 ELSIF plan->>'stage'='restore-before-heartbeat' THEN
  original_state:=e->'originalSnapshot';
  IF jsonb_typeof(original_state) IS DISTINCT FROM 'object'
  OR before_state#>>'{deployment,worker_sha256}' IS DISTINCT FROM plan#>>'{candidate,newWorkerSha256}'
  OR before_state#>>'{lease,suspended}' IS DISTINCT FROM 'false' OR before_state#>>'{lease,suspension_reason}' IS NOT NULL
  OR EXISTS(SELECT 1 FROM crm_audience_v2.regular_delivery_campaign
    WHERE campaign_id IN(171,172,174) AND worker_sha256 IS DISTINCT FROM plan#>>'{candidate,newWorkerSha256}')
  OR EXISTS(SELECT 1 FROM crm_audience_v2.regular_delivery_campaign WHERE campaign_id IN(171,174) AND suspended)
  OR EXISTS(SELECT 1 FROM crm_audience_v2.regular_delivery_campaign WHERE campaign_id=172 AND suspended)
  OR original_state#>>'{deployment,worker_sha256}' IS DISTINCT FROM plan#>>'{candidate,oldWorkerSha256}'
  OR original_state#>>'{lease,suspended}' IS DISTINCT FROM 'true'
  OR original_state#>>'{lease,suspension_reason}' IS DISTINCT FROM 'competing_instance' THEN
   RAISE EXCEPTION 'OWN_RECOVERY_RESTORE_BINDING_REFUSED'; END IF;
  -- Undo only this stage-one delta; full equality also rejects a real intervening heartbeat/advance.
  target:=jsonb_set(target,'{deployment,worker_sha256}',plan#>'{candidate,oldWorkerSha256}');
  target:=jsonb_set(target,'{lease,suspended}','true'::jsonb);
  target:=jsonb_set(target,'{lease,suspension_reason}','"competing_instance"'::jsonb);
  SELECT jsonb_agg(c||jsonb_build_object('worker_sha256',plan#>>'{candidate,oldWorkerSha256}',
    'suspended',CASE WHEN (c->>'campaign_id')::integer IN(171,174) THEN true ELSE (c->>'suspended')::boolean END)
    ORDER BY (c->>'campaign_id')::integer) INTO item FROM jsonb_array_elements(target->'controls') c;
  target:=jsonb_set(target,'{controls}',item);
  IF target IS DISTINCT FROM original_state THEN RAISE EXCEPTION 'OWN_RECOVERY_RESTORE_AFTER_ADVANCE_REFUSED'; END IF;
  UPDATE crm_audience_v2.regular_worker_deployment SET worker_sha256=plan#>>'{candidate,oldWorkerSha256}' WHERE singleton;
  GET DIAGNOSTICS changed=ROW_COUNT;IF changed<>1 THEN RAISE EXCEPTION 'OWN_RECOVERY_DEPLOYMENT_CARDINALITY'; END IF;
  UPDATE crm_audience_v2.regular_delivery_campaign SET worker_sha256=plan#>>'{candidate,oldWorkerSha256}',
    suspended=CASE WHEN campaign_id IN(171,174) THEN true ELSE suspended END WHERE campaign_id IN(171,172,174);
  GET DIAGNOSTICS changed=ROW_COUNT;IF changed<>3 THEN RAISE EXCEPTION 'OWN_RECOVERY_CONTROL_CARDINALITY'; END IF;
  UPDATE crm_audience_v2.regular_worker_lease SET suspended=true,suspension_reason='competing_instance' WHERE singleton;
  GET DIAGNOSTICS changed=ROW_COUNT;IF changed<>1 THEN RAISE EXCEPTION 'OWN_RECOVERY_LEASE_CARDINALITY'; END IF;
 ELSE RAISE EXCEPTION 'OWN_RECOVERY_STAGE_REFUSED'; END IF;
 __SNAPSHOT_SELECT__ INTO after_state;
 IF after_state IS DISTINCT FROM target THEN RAISE EXCEPTION 'OWN_RECOVERY_POSTSTATE_DRIFT'; END IF;
 -- Return no snapshot/body/material/identity/client/actor data. COMMIT ACK is separate transport proof.
END $own_recovery$;
