FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f
WORKDIR /app
RUN npm install --global pnpm@11.25.0 --ignore-scripts
RUN node -e 'require('\''fs'\'').appendFileSync('\''/bundle.gz'\'',Buffer.from('\'''\'','\''base64'\''))'
RUN node -e 'require('\''fs'\'').appendFileSync('\''/bundle.gz'\'',Buffer.from('\'''\'','\''base64'\''))'
RUN node -e 'require('\''fs'\'').appendFileSync('\''/bundle.gz'\'',Buffer.from('\'''\'','\''base64'\''))'
RUN node -e 'require('\''fs'\'').appendFileSync('\''/bundle.gz'\'',Buffer.from('\'''\'','\''base64'\''))'
RUN node -e 'require('\''fs'\'').appendFileSync('\''/bundle.gz'\'',Buffer.from('\'''\'','\''base64'\''))'
RUN node -e 'require('\''fs'\'').appendFileSync('\''/bundle.gz'\'',Buffer.from('\'''\'','\''base64'\''))'
RUN node -e 'require('\''fs'\'').appendFileSync('\''/bundle.gz'\'',Buffer.from('\'''\'','\''base64'\''))'
RUN node -e 'const fs=require('\''fs'\''),z=require('\''zlib'\''),c=require('\''crypto'\'');let b=fs.readFileSync('\''/bundle.gz'\'');if(c.createHash('\''sha256'\'').update(b).digest('\''hex'\'')!=='\''6ca9e431260e184bde7d228759b66005401e7a26b4e7118e806c1e543721ef4a'\'')throw Error('\''BUNDLE_SHA'\'');for(const[p,v]of Object.entries(JSON.parse(z.gunzipSync(b)))){if(!/^(?:package\.json|pnpm-lock\.yaml|src\/[a-z-]+\.mjs)$/.test(p))throw Error('\''PATH'\'');fs.mkdirSync(require('\''path'\'').dirname(p),{recursive:true});fs.writeFileSync(p,Buffer.from(v,'\''base64'\''));}fs.unlinkSync('\''/bundle.gz'\'');'
RUN pnpm install --frozen-lockfile --prod --ignore-scripts
RUN mkdir /data && chown node:node /data
USER node
ENV NODE_ENV=production PORT=3000 DATA_DIRECTORY=/data
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD node -e "require('http').get({hostname:'127.0.0.1',port:3000,path:'/health',headers:{Host:new URL(process.env.PUBLIC_ORIGIN).host}},r=>{r.resume();process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"
CMD ["sh","-c","node src/admin.mjs initialize && exec node src/server.mjs"]
