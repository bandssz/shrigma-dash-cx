FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
ARG GIT_SHA
LABEL org.opencontainers.image.title="Shrigma isolated identity envelope" \
      org.opencontainers.image.source="https://github.com/bandssz/shrigma-dash-cx" \
      org.opencontainers.image.revision="$GIT_SHA"
WORKDIR /app
RUN mkdir /snapshot-data /cipher-output \
 && chown 1000:1000 /snapshot-data /cipher-output \
 && chmod 0700 /snapshot-data /cipher-output
COPY --chmod=0444 services/dashboard-operational/backup-identity.cjs services/dashboard-operational/identity-envelope.cjs ./
USER 1000:1000
STOPSIGNAL SIGTERM
ENTRYPOINT ["node", "/app/identity-envelope.cjs"]
