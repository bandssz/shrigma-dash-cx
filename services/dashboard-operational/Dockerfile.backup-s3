# AWS publishes and supports this CLI v2 image. Both bases are immutable OCI
# manifests; the AWS CLI is copied into a glibc-based Node runtime, not installed
# from a moving package repository during the server deployment.
FROM public.ecr.aws/aws-cli/aws-cli:2.37.7@sha256:95f8d1e6d31aaa16997d1406eb532b0ca6a9830fe8a859c37a0fd223f10959e5 AS awscli
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
ARG GIT_SHA
LABEL org.opencontainers.image.title="Shrigma isolated S3 identity backup transport" \
      org.opencontainers.image.source="https://github.com/bandssz/shrigma-dash-cx" \
      org.opencontainers.image.revision="$GIT_SHA"

COPY --from=awscli /usr/local/aws-cli /usr/local/aws-cli
RUN ln -s /usr/local/aws-cli/v2/current/bin/aws /usr/local/bin/aws \
 && aws --version 2>&1 | grep '^aws-cli/2\.37\.7 ' \
 && mkdir /app /backup-data /receipt-data /restore-data \
 && chown 1000:1000 /receipt-data /restore-data \
 && chmod 0700 /receipt-data /restore-data
WORKDIR /app
COPY --chmod=0444 services/dashboard-operational/backup-identity.cjs services/dashboard-operational/backup-s3.cjs ./
ENV HOME=/home/node AWS_PAGER= AWS_CLI_AUTO_PROMPT=off AWS_EC2_METADATA_DISABLED=true
USER 1000:1000
STOPSIGNAL SIGTERM
ENTRYPOINT ["node", "/app/backup-s3.cjs"]
