FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402
ARG GIT_SHA
LABEL org.opencontainers.image.title="Shrigma synthetic canary backup rehearsal" \
      org.opencontainers.image.source="https://github.com/bandssz/shrigma-dash-cx" \
      org.opencontainers.image.revision="$GIT_SHA"
WORKDIR /app
COPY --chmod=0444 services/dashboard-operational/artifact-policy.cjs services/dashboard-operational/backup-identity.cjs services/dashboard-operational/backup-canary-job.cjs ./
RUN mkdir /source-data /backup-data /restore-data \
 && chown 1000:1000 /backup-data /restore-data \
 && chmod 0700 /backup-data /restore-data
USER 1000:1000
STOPSIGNAL SIGTERM
ENTRYPOINT ["node", "/app/backup-canary-job.cjs"]
