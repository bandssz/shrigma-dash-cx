FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
ARG GIT_SHA
LABEL org.opencontainers.image.title="Shrigma fixed ciphertext reader" \
      org.opencontainers.image.source="https://github.com/bandssz/shrigma-dash-cx" \
      org.opencontainers.image.revision="$GIT_SHA"
WORKDIR /app
RUN mkdir /cipher-data && chown 1000:1000 /cipher-data && chmod 0700 /cipher-data
COPY --chmod=0444 services/dashboard-operational/cipher-reader.cjs ./
USER 1000:1000
STOPSIGNAL SIGTERM
ENTRYPOINT ["node", "/app/cipher-reader.cjs"]
