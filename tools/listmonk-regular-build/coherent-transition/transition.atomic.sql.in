DO $coherent_transition$
DECLARE
 e jsonb:=current_setting('shrigma.private_transition_envelope',true)::jsonb;
 plan jsonb:=__PLAN_JSON_LITERAL__::jsonb;
 before_state jsonb;after_state jsonb;target_deployment jsonb;target_controls jsonb;
 f_before jsonb;f_after jsonb;expected_source text:=__EXPECTED_BODY_LITERAL__;
 target_source text:=__TARGET_BODY_LITERAL__;target_md5 text:=__TARGET_MD5_LITERAL__;
 ids jsonb;count_changed integer;ctl jsonb;constraint_name text;
 at timestamptz;admission jsonb;
BEGIN
 IF e IS NULL OR jsonb_typeof(e)<>'object' OR e->'plan' IS DISTINCT FROM plan
 OR e->'snapshot' IS NULL OR e->'privateAdmission' IS NULL THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_PRIVATE_EVIDENCE_REQUIRED';
 END IF;
 -- References are not authority. Root must verify them through existing private
 -- authority before this transaction; no new issuer/grant/admission is created.
 admission:=e->'privateAdmission';at:=clock_timestamp();
 IF admission->>'operationId' IS DISTINCT FROM plan->>'operationId'
 OR admission->>'purpose' IS DISTINCT FROM plan->>'admissionPurpose'
 OR admission->>'admissionSha256' IS DISTINCT FROM plan#>>'{privateReferences,admission,sha256}'
 OR admission->>'restoreSha256' IS DISTINCT FROM plan#>>'{privateReferences,restore,sha256}'
 OR admission->>'snapshotSha256' IS DISTINCT FROM plan#>>'{privateReferences,snapshot,sha256}'
 OR admission->>'quiescenceSha256' IS DISTINCT FROM plan#>>'{privateReferences,quiescence,sha256}'
 OR admission->'candidate' IS DISTINCT FROM plan->'candidate'
 OR admission->>'actor' IS NULL OR length(admission->>'actor') NOT BETWEEN 1 AND 200
 OR NOT isfinite((admission->>'checkedAt')::timestamptz)
 OR NOT isfinite((admission->>'expiresAt')::timestamptz)
 OR (admission->>'checkedAt')::timestamptz>at OR (admission->>'expiresAt')::timestamptz<=at
 OR (admission->>'expiresAt')::timestamptz>(admission->>'checkedAt')::timestamptz+interval '5 minutes'
 OR admission->>'checkedAt' IS NULL OR admission->>'expiresAt' IS NULL THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_PRIVATE_ADMISSION_MISMATCH';
 END IF;
 -- Fixed lock order agrees with the original deployment/lease boundary.
 LOCK TABLE crm_audience_v2.regular_worker_deployment IN ACCESS EXCLUSIVE MODE;
 PERFORM pg_advisory_xact_lock(hashtextextended('crm-audience-v2-regular-worker-lease',0));
 PERFORM 1 FROM crm_audience_v2.regular_worker_lease WHERE singleton FOR SHARE;
 PERFORM 1 FROM crm_audience_v2.selection_runtime WHERE singleton FOR SHARE;
 LOCK TABLE crm_audience_v2.regular_delivery_campaign IN SHARE ROW EXCLUSIVE MODE;
 -- Control-table boundary freezes enabled/tuple/INSERT/DELETE. Candidate campaign
 -- rows include every enabled old-tuple control, so a finished/legacy row cannot
 -- concurrently change status/type/brand into a phantom owned active row.
 IF (SELECT count(*) FROM crm_audience_v2.regular_delivery_campaign c CROSS JOIN crm_audience_v2.regular_worker_deployment d
     WHERE d.singleton AND c.enabled AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256)>1024 THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_OWNED_SET_BOUND_EXCEEDED'; END IF;
 PERFORM 1 FROM public.campaigns p WHERE p.id IN(SELECT c.campaign_id FROM crm_audience_v2.regular_delivery_campaign c
  CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled
  AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256) ORDER BY p.id FOR SHARE;
 PERFORM 1 FROM crm_audience_v2.campaign_binding b WHERE b.campaign_id IN(SELECT c.campaign_id FROM crm_audience_v2.regular_delivery_campaign c
  CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled
  AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256) ORDER BY b.campaign_id FOR SHARE;
 SELECT jsonb_build_object(
 'serverVersionNum',current_setting('server_version_num')::integer,
 'sessionUser',session_user,'currentUser',current_user,
 'function',(SELECT to_jsonb(p) FROM pg_catalog.pg_proc p WHERE p.oid=pg_catalog.to_regprocedure('crm_audience_v2.selection_worker_context(integer)')),'queryConstraint',(SELECT jsonb_build_object('name',c.conname,'definition',pg_catalog.pg_get_constraintdef(c.oid,true),'expression',pg_catalog.pg_get_expr(c.conbin,c.conrelid),'validated',c.convalidated,'noinherit',c.connoinherit,'deferrable',c.condeferrable,'deferred',c.condeferred,'keys',to_jsonb(c.conkey)) FROM pg_catalog.pg_constraint c WHERE c.conrelid='crm_audience_v2.regular_worker_deployment'::regclass AND c.contype='c' AND c.conkey=ARRAY[(SELECT attnum FROM pg_catalog.pg_attribute WHERE attrelid='crm_audience_v2.regular_worker_deployment'::regclass AND attname='query_sha256')]::smallint[]),
 'deployment',(SELECT to_jsonb(d) FROM crm_audience_v2.regular_worker_deployment d WHERE singleton),
 'lease',(SELECT to_jsonb(l) FROM crm_audience_v2.regular_worker_lease l WHERE singleton),
 'selectionRuntime',(SELECT to_jsonb(r) FROM crm_audience_v2.selection_runtime r WHERE singleton),
 'preservedFunctionMetadata',(SELECT coalesce(jsonb_object_agg(s.signature,to_jsonb(p) ORDER BY s.signature),'{}'::jsonb) FROM (VALUES ('crm_audience_v2.regular_worker_heartbeat(uuid,text,text)'),('crm_audience_v2.regular_worker_require(uuid,text,text)'),('crm_audience_v2.regular_delivery_claim(integer,integer,uuid,text,text,text,text,text,jsonb)'),('crm_audience_v2.regular_delivery_finish(integer,integer,uuid,uuid,text)')) s(signature) LEFT JOIN pg_catalog.pg_proc p ON p.oid=pg_catalog.to_regprocedure(s.signature)),'relationMetadata',(SELECT jsonb_object_agg(r.name,jsonb_build_object('oid',c.oid,'namespace',c.relnamespace,'owner',c.relowner,'acl',to_jsonb(c.relacl),'options',to_jsonb(c.reloptions),'kind',c.relkind,'rls',c.relrowsecurity,'forceRls',c.relforcerowsecurity) ORDER BY r.name) FROM (VALUES ('crm_audience_v2.regular_worker_deployment'),('crm_audience_v2.regular_worker_lease'),('crm_audience_v2.selection_runtime'),('crm_audience_v2.regular_delivery_campaign')) r(name) LEFT JOIN pg_catalog.pg_class c ON c.oid=pg_catalog.to_regclass(r.name)),'mutationTriggers',(SELECT coalesce(jsonb_agg(jsonb_build_object('relation',tgrelid,'oid',oid,'enabled',tgenabled,'function',tgfoid) ORDER BY oid),'[]'::jsonb) FROM pg_catalog.pg_trigger WHERE NOT tgisinternal AND tgrelid IN('crm_audience_v2.regular_worker_deployment'::regclass,'crm_audience_v2.regular_delivery_campaign'::regclass)),
 'controls',(SELECT coalesce(jsonb_agg(to_jsonb(c) ORDER BY c.campaign_id),'[]'::jsonb) FROM crm_audience_v2.regular_delivery_campaign c WHERE c.campaign_id IN(SELECT c.campaign_id FROM crm_audience_v2.regular_delivery_campaign c JOIN public.campaigns p ON p.id=c.campaign_id CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled AND p.type::text='regular' AND p.messenger='email' AND p.attribs#>>'{crm,policy}'='crm-campaign-v1' AND p.attribs#>>'{crm,brand}' IN('fish','aristo') AND p.status::text IN('scheduled','running','paused') AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256)),'ownedActiveCampaignIds',(SELECT coalesce(jsonb_agg(c.campaign_id ORDER BY c.campaign_id),'[]'::jsonb) FROM crm_audience_v2.regular_delivery_campaign c JOIN public.campaigns p ON p.id=c.campaign_id CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled AND p.type::text='regular' AND p.messenger='email' AND p.attribs#>>'{crm,policy}'='crm-campaign-v1' AND p.attribs#>>'{crm,brand}' IN('fish','aristo') AND p.status::text IN('scheduled','running','paused') AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256),'ownedRowState',jsonb_build_object(
'campaigns',(SELECT coalesce(jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text COLLATE "C"),'[]'::jsonb) FROM (SELECT t.* FROM public.campaigns t WHERE t.id IN(SELECT c.campaign_id FROM crm_audience_v2.regular_delivery_campaign c JOIN public.campaigns p ON p.id=c.campaign_id CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled AND p.type::text='regular' AND p.messenger='email' AND p.attribs#>>'{crm,policy}'='crm-campaign-v1' AND p.attribs#>>'{crm,brand}' IN('fish','aristo') AND p.status::text IN('scheduled','running','paused') AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256) ORDER BY to_jsonb(t)::text COLLATE "C" LIMIT 4097) t),
'bindings',(SELECT coalesce(jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text COLLATE "C"),'[]'::jsonb) FROM (SELECT t.* FROM crm_audience_v2.campaign_binding t WHERE t.campaign_id IN(SELECT c.campaign_id FROM crm_audience_v2.regular_delivery_campaign c JOIN public.campaigns p ON p.id=c.campaign_id CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled AND p.type::text='regular' AND p.messenger='email' AND p.attribs#>>'{crm,policy}'='crm-campaign-v1' AND p.attribs#>>'{crm,brand}' IN('fish','aristo') AND p.status::text IN('scheduled','running','paused') AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256) ORDER BY to_jsonb(t)::text COLLATE "C" LIMIT 4097) t),
'bindingHistory',(SELECT coalesce(jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text COLLATE "C"),'[]'::jsonb) FROM (SELECT t.* FROM crm_audience_v2.campaign_binding_revision t WHERE t.campaign_id IN(SELECT c.campaign_id FROM crm_audience_v2.regular_delivery_campaign c JOIN public.campaigns p ON p.id=c.campaign_id CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled AND p.type::text='regular' AND p.messenger='email' AND p.attribs#>>'{crm,policy}'='crm-campaign-v1' AND p.attribs#>>'{crm,brand}' IN('fish','aristo') AND p.status::text IN('scheduled','running','paused') AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256) ORDER BY to_jsonb(t)::text COLLATE "C" LIMIT 4097) t),
'dispatch',(SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY x.dispatch_id),'[]'::jsonb) FROM (SELECT x.* FROM public.shrigma_email_dispatch x WHERE x.flow='campaign' AND x.piece IN(SELECT 'audience-regular-v1:'||owned.campaign_id::text FROM (SELECT c.campaign_id FROM crm_audience_v2.regular_delivery_campaign c JOIN public.campaigns p ON p.id=c.campaign_id CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled AND p.type::text='regular' AND p.messenger='email' AND p.attribs#>>'{crm,policy}'='crm-campaign-v1' AND p.attribs#>>'{crm,brand}' IN('fish','aristo') AND p.status::text IN('scheduled','running','paused') AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256) owned) ORDER BY x.dispatch_id LIMIT 4097) x))
) INTO before_state;

 IF before_state->'mutationTriggers' IS DISTINCT FROM '[]'::jsonb THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_UNADMITTED_MUTATION_TRIGGER'; END IF;
 IF before_state IS DISTINCT FROM e->'snapshot' THEN RAISE EXCEPTION 'COHERENT_TRANSITION_SNAPSHOT_DRIFT'; END IF;
 IF EXISTS(SELECT 1 FROM jsonb_each(before_state->'ownedRowState') item WHERE jsonb_array_length(item.value)>4096) THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_OWNED_ROW_BOUND_EXCEEDED'; END IF;
 IF EXISTS(SELECT 1 FROM jsonb_each(before_state->'preservedFunctionMetadata') fn WHERE fn.value='null'::jsonb)
 OR EXISTS(SELECT 1 FROM jsonb_each(before_state->'relationMetadata') rel WHERE rel.value->'oid'='null'::jsonb
  OR rel.value->>'kind' NOT IN('r','p')) THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_ORIGINAL_OBJECT_MISSING';
 END IF;
 IF before_state#>>'{deployment,enabled}' IS DISTINCT FROM 'true'
 OR before_state#>>'{deployment,query_sha256}' IS DISTINCT FROM plan->>'expectedQuerySha256'
 OR before_state#>>'{deployment,approved_by}' IS NULL
 OR before_state#>>'{deployment,database_role}' IS NULL
 OR before_state#>>'{lease,suspended}' IS DISTINCT FROM 'false'
 OR before_state#>>'{lease,suspension_reason}' IS NOT NULL
 OR before_state#>>'{lease,instance_id}' IS NULL
 OR before_state#>>'{lease,worker_sha256}' IS DISTINCT FROM (CASE WHEN plan->>'mode'='forward' THEN before_state#>>'{deployment,worker_sha256}' ELSE e->'originalSnapshot'#>>'{deployment,worker_sha256}' END)
 OR before_state#>>'{lease,runtime_sha256}' IS DISTINCT FROM (CASE WHEN plan->>'mode'='forward' THEN before_state#>>'{deployment,runtime_sha256}' ELSE e->'originalSnapshot'#>>'{deployment,runtime_sha256}' END)
 OR before_state#>>'{lease,database_role}' IS DISTINCT FROM before_state#>>'{deployment,database_role}'
 OR NOT isfinite((before_state#>>'{lease,expires_at}')::timestamptz)
 OR (before_state#>>'{lease,expires_at}')::timestamptz>clock_timestamp()
 OR (before_state#>>'{lease,heartbeat_at}')::timestamptz>clock_timestamp() THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_LEASE_OR_DEPLOYMENT_UNAVAILABLE';
 END IF;
 ids:=before_state->'ownedActiveCampaignIds';
 IF jsonb_array_length(ids)=0 OR ids IS DISTINCT FROM e->'ownedCampaignIds' THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_COMPLETE_CONTROL_ENUMERATION_REQUIRED';
 END IF;
 -- Stop for every owned control, including historical/suspended controls with
 -- uncertain attempts. Nothing here recovers, resumes or acknowledges delivery.
 IF EXISTS(SELECT 1 FROM public.campaigns c JOIN crm_audience_v2.regular_delivery_campaign d ON d.campaign_id=c.id
  WHERE d.worker_sha256=before_state#>>'{deployment,worker_sha256}'
   AND d.runtime_sha256=before_state#>>'{deployment,runtime_sha256}' AND c.status::text='running')
 OR EXISTS(SELECT 1 FROM public.shrigma_email_dispatch x JOIN crm_audience_v2.regular_delivery_campaign d
  ON x.piece='audience-regular-v1:'||d.campaign_id::text
  WHERE x.flow='campaign' AND x.transport_state IN('in_flight','outcome_unknown')
   AND d.worker_sha256=before_state#>>'{deployment,worker_sha256}'
   AND d.runtime_sha256=before_state#>>'{deployment,runtime_sha256}')
 OR (plan->>'mode'='rollback' AND EXISTS(SELECT 1 FROM public.shrigma_email_dispatch x JOIN crm_audience_v2.regular_delivery_campaign d
  ON x.piece='audience-regular-v1:'||d.campaign_id::text WHERE x.flow='campaign' AND x.transport_state IN('in_flight','outcome_unknown')
   AND d.worker_sha256=e->'originalSnapshot'#>>'{deployment,worker_sha256}'
   AND d.runtime_sha256=e->'originalSnapshot'#>>'{deployment,runtime_sha256}')) THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_RUNNING_OR_UNCERTAIN_DELIVERY';
 END IF;
 IF admission->'sendTargets' IS DISTINCT FROM plan->'sendTargets' THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_SEND_TARGET_ADMISSION_REQUIRED';
 END IF;
 IF EXISTS(SELECT 1 FROM jsonb_array_elements(plan->'sendTargets') target
  WHERE NOT EXISTS(SELECT 1 FROM crm_audience_v2.regular_delivery_campaign c JOIN public.campaigns p ON p.id=c.campaign_id
   WHERE c.campaign_id=(target->>'campaignId')::integer AND ids @> jsonb_build_array(c.campaign_id)
    AND c.enabled AND NOT c.suspended AND p.status::text='scheduled')) THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_SEND_TARGET_INACTIVE_OR_SUSPENDED';
 END IF;
 f_before:=before_state->'function';
 IF f_before->>'prosrc' IS DISTINCT FROM expected_source
 OR f_before->>'prosecdef' IS DISTINCT FROM 'false' OR f_before->>'provolatile' IS DISTINCT FROM 's'
 OR f_before->'proconfig' IS DISTINCT FROM '["search_path=pg_catalog"]'::jsonb
 OR before_state#>>'{queryConstraint,validated}' IS DISTINCT FROM 'true'
 OR before_state#>>'{queryConstraint,noinherit}' IS DISTINCT FROM 'false'
 OR before_state#>>'{queryConstraint,deferrable}' IS DISTINCT FROM 'false'
 OR before_state#>>'{queryConstraint,deferred}' IS DISTINCT FROM 'false'
 OR before_state#>>'{queryConstraint,expression}' IS DISTINCT FROM
  '(query_sha256 = '||quote_literal(plan->>'expectedQuerySha256')||'::text)' THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_CONTEXT_OR_CONSTRAINT_DRIFT';
 END IF;
 constraint_name:=before_state#>>'{queryConstraint,name}';
 IF plan->>'mode'='forward' THEN
  IF plan#>>'{candidate,workerSha256}' IS NOT DISTINCT FROM before_state#>>'{deployment,worker_sha256}'
   OR admission->>'approvedAt' IS NULL OR NOT isfinite((admission->>'approvedAt')::timestamptz)
   OR (admission->>'approvedAt')::timestamptz>clock_timestamp()
   OR admission->>'topologySha256' !~ '^[0-9a-f]{64}$' OR admission->>'topologySha256' IS NULL
   OR e->'originalSnapshot' IS NOT NULL THEN RAISE EXCEPTION 'COHERENT_TRANSITION_NEW_APPROVAL_REQUIRED'; END IF;
  target_deployment:=(before_state->'deployment')||jsonb_build_object(
   'worker_sha256',plan#>>'{candidate,workerSha256}','runtime_sha256',plan#>>'{candidate,runtimeSha256}',
   'query_sha256',plan->>'targetQuerySha256','approved_at',(admission->>'approvedAt')::timestamptz,
   'approved_by',admission->>'actor','topology_receipt_sha256',admission->>'topologySha256');
 ELSE
  IF e->'originalSnapshot' IS NULL OR e->'originalSnapshot'->'ownedRowState' IS DISTINCT FROM before_state->'ownedRowState'
   OR e->'originalSnapshot'->'lease' IS DISTINCT FROM before_state->'lease'
   OR e->'originalSnapshot'->'selectionRuntime' IS DISTINCT FROM before_state->'selectionRuntime'
   OR before_state#>>'{deployment,worker_sha256}' IS DISTINCT FROM plan#>>'{candidate,workerSha256}'
   OR before_state#>>'{deployment,runtime_sha256}' IS DISTINCT FROM plan#>>'{candidate,runtimeSha256}'
   OR e->'originalSnapshot'#>>'{deployment,query_sha256}' IS DISTINCT FROM plan->>'targetQuerySha256'
   OR e->'originalSnapshot'->'ownedActiveCampaignIds' IS DISTINCT FROM ids THEN
   RAISE EXCEPTION 'COHERENT_TRANSITION_RESTORE_REQUIRES_UNCHANGED_ORIGINAL';
  END IF;
  IF e->'originalSnapshot'->'preservedFunctionMetadata' IS DISTINCT FROM before_state->'preservedFunctionMetadata'
   OR e->'originalSnapshot'->'relationMetadata' IS DISTINCT FROM before_state->'relationMetadata' THEN
   RAISE EXCEPTION 'COHERENT_TRANSITION_RESTORE_METADATA_DRIFT'; END IF;
  target_deployment:=e->'originalSnapshot'->'deployment';
 END IF;
 SELECT coalesce(jsonb_agg(CASE WHEN ids @> jsonb_build_array((row->>'campaign_id')::integer)
  THEN row||jsonb_build_object('worker_sha256',target_deployment->>'worker_sha256',
    'runtime_sha256',target_deployment->>'runtime_sha256') ELSE row END ORDER BY (row->>'campaign_id')::integer),'[]'::jsonb)
 INTO target_controls FROM jsonb_array_elements(before_state->'controls') row;
 IF plan->>'mode'='rollback' AND target_controls IS DISTINCT FROM e->'originalSnapshot'->'controls' THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_CONTROL_RESTORE_DRIFT';
 END IF;
 -- Only the exact check changes; never accept a set/range of arbitrary hashes.
 EXECUTE format('ALTER TABLE crm_audience_v2.regular_worker_deployment DROP CONSTRAINT %I',constraint_name);
 EXECUTE 'CREATE OR REPLACE FUNCTION crm_audience_v2.selection_worker_context(cid integer) RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY INVOKER SET search_path=pg_catalog AS '||quote_literal(target_source);
 UPDATE crm_audience_v2.regular_worker_deployment SET
  worker_sha256=target_deployment->>'worker_sha256',runtime_sha256=target_deployment->>'runtime_sha256',
  query_sha256=target_deployment->>'query_sha256',database_role=(target_deployment->>'database_role')::name,
  approved_at=(target_deployment->>'approved_at')::timestamptz,approved_by=target_deployment->>'approved_by',
  topology_receipt_sha256=target_deployment->>'topology_receipt_sha256' WHERE singleton;
 GET DIAGNOSTICS count_changed=ROW_COUNT;
 IF count_changed<>1 THEN RAISE EXCEPTION 'COHERENT_TRANSITION_DEPLOYMENT_CARDINALITY'; END IF;
 EXECUTE format('ALTER TABLE crm_audience_v2.regular_worker_deployment ADD CONSTRAINT %I CHECK(query_sha256=%L)',constraint_name,plan->>'targetQuerySha256');
 UPDATE crm_audience_v2.regular_delivery_campaign c SET worker_sha256=target_deployment->>'worker_sha256',
  runtime_sha256=target_deployment->>'runtime_sha256' WHERE c.enabled
  AND ids @> jsonb_build_array(c.campaign_id);
 GET DIAGNOSTICS count_changed=ROW_COUNT;
 IF count_changed<>jsonb_array_length(ids) THEN RAISE EXCEPTION 'COHERENT_TRANSITION_CONTROL_CARDINALITY'; END IF;
 SELECT jsonb_build_object(
 'serverVersionNum',current_setting('server_version_num')::integer,
 'sessionUser',session_user,'currentUser',current_user,
 'function',(SELECT to_jsonb(p) FROM pg_catalog.pg_proc p WHERE p.oid=pg_catalog.to_regprocedure('crm_audience_v2.selection_worker_context(integer)')),'queryConstraint',(SELECT jsonb_build_object('name',c.conname,'definition',pg_catalog.pg_get_constraintdef(c.oid,true),'expression',pg_catalog.pg_get_expr(c.conbin,c.conrelid),'validated',c.convalidated,'noinherit',c.connoinherit,'deferrable',c.condeferrable,'deferred',c.condeferred,'keys',to_jsonb(c.conkey)) FROM pg_catalog.pg_constraint c WHERE c.conrelid='crm_audience_v2.regular_worker_deployment'::regclass AND c.contype='c' AND c.conkey=ARRAY[(SELECT attnum FROM pg_catalog.pg_attribute WHERE attrelid='crm_audience_v2.regular_worker_deployment'::regclass AND attname='query_sha256')]::smallint[]),
 'deployment',(SELECT to_jsonb(d) FROM crm_audience_v2.regular_worker_deployment d WHERE singleton),
 'lease',(SELECT to_jsonb(l) FROM crm_audience_v2.regular_worker_lease l WHERE singleton),
 'selectionRuntime',(SELECT to_jsonb(r) FROM crm_audience_v2.selection_runtime r WHERE singleton),
 'preservedFunctionMetadata',(SELECT coalesce(jsonb_object_agg(s.signature,to_jsonb(p) ORDER BY s.signature),'{}'::jsonb) FROM (VALUES ('crm_audience_v2.regular_worker_heartbeat(uuid,text,text)'),('crm_audience_v2.regular_worker_require(uuid,text,text)'),('crm_audience_v2.regular_delivery_claim(integer,integer,uuid,text,text,text,text,text,jsonb)'),('crm_audience_v2.regular_delivery_finish(integer,integer,uuid,uuid,text)')) s(signature) LEFT JOIN pg_catalog.pg_proc p ON p.oid=pg_catalog.to_regprocedure(s.signature)),'relationMetadata',(SELECT jsonb_object_agg(r.name,jsonb_build_object('oid',c.oid,'namespace',c.relnamespace,'owner',c.relowner,'acl',to_jsonb(c.relacl),'options',to_jsonb(c.reloptions),'kind',c.relkind,'rls',c.relrowsecurity,'forceRls',c.relforcerowsecurity) ORDER BY r.name) FROM (VALUES ('crm_audience_v2.regular_worker_deployment'),('crm_audience_v2.regular_worker_lease'),('crm_audience_v2.selection_runtime'),('crm_audience_v2.regular_delivery_campaign')) r(name) LEFT JOIN pg_catalog.pg_class c ON c.oid=pg_catalog.to_regclass(r.name)),'mutationTriggers',(SELECT coalesce(jsonb_agg(jsonb_build_object('relation',tgrelid,'oid',oid,'enabled',tgenabled,'function',tgfoid) ORDER BY oid),'[]'::jsonb) FROM pg_catalog.pg_trigger WHERE NOT tgisinternal AND tgrelid IN('crm_audience_v2.regular_worker_deployment'::regclass,'crm_audience_v2.regular_delivery_campaign'::regclass)),
 'controls',(SELECT coalesce(jsonb_agg(to_jsonb(c) ORDER BY c.campaign_id),'[]'::jsonb) FROM crm_audience_v2.regular_delivery_campaign c WHERE c.campaign_id IN(SELECT c.campaign_id FROM crm_audience_v2.regular_delivery_campaign c JOIN public.campaigns p ON p.id=c.campaign_id CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled AND p.type::text='regular' AND p.messenger='email' AND p.attribs#>>'{crm,policy}'='crm-campaign-v1' AND p.attribs#>>'{crm,brand}' IN('fish','aristo') AND p.status::text IN('scheduled','running','paused') AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256)),'ownedActiveCampaignIds',(SELECT coalesce(jsonb_agg(c.campaign_id ORDER BY c.campaign_id),'[]'::jsonb) FROM crm_audience_v2.regular_delivery_campaign c JOIN public.campaigns p ON p.id=c.campaign_id CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled AND p.type::text='regular' AND p.messenger='email' AND p.attribs#>>'{crm,policy}'='crm-campaign-v1' AND p.attribs#>>'{crm,brand}' IN('fish','aristo') AND p.status::text IN('scheduled','running','paused') AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256),'ownedRowState',jsonb_build_object(
'campaigns',(SELECT coalesce(jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text COLLATE "C"),'[]'::jsonb) FROM (SELECT t.* FROM public.campaigns t WHERE t.id IN(SELECT c.campaign_id FROM crm_audience_v2.regular_delivery_campaign c JOIN public.campaigns p ON p.id=c.campaign_id CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled AND p.type::text='regular' AND p.messenger='email' AND p.attribs#>>'{crm,policy}'='crm-campaign-v1' AND p.attribs#>>'{crm,brand}' IN('fish','aristo') AND p.status::text IN('scheduled','running','paused') AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256) ORDER BY to_jsonb(t)::text COLLATE "C" LIMIT 4097) t),
'bindings',(SELECT coalesce(jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text COLLATE "C"),'[]'::jsonb) FROM (SELECT t.* FROM crm_audience_v2.campaign_binding t WHERE t.campaign_id IN(SELECT c.campaign_id FROM crm_audience_v2.regular_delivery_campaign c JOIN public.campaigns p ON p.id=c.campaign_id CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled AND p.type::text='regular' AND p.messenger='email' AND p.attribs#>>'{crm,policy}'='crm-campaign-v1' AND p.attribs#>>'{crm,brand}' IN('fish','aristo') AND p.status::text IN('scheduled','running','paused') AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256) ORDER BY to_jsonb(t)::text COLLATE "C" LIMIT 4097) t),
'bindingHistory',(SELECT coalesce(jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text COLLATE "C"),'[]'::jsonb) FROM (SELECT t.* FROM crm_audience_v2.campaign_binding_revision t WHERE t.campaign_id IN(SELECT c.campaign_id FROM crm_audience_v2.regular_delivery_campaign c JOIN public.campaigns p ON p.id=c.campaign_id CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled AND p.type::text='regular' AND p.messenger='email' AND p.attribs#>>'{crm,policy}'='crm-campaign-v1' AND p.attribs#>>'{crm,brand}' IN('fish','aristo') AND p.status::text IN('scheduled','running','paused') AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256) ORDER BY to_jsonb(t)::text COLLATE "C" LIMIT 4097) t),
'dispatch',(SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY x.dispatch_id),'[]'::jsonb) FROM (SELECT x.* FROM public.shrigma_email_dispatch x WHERE x.flow='campaign' AND x.piece IN(SELECT 'audience-regular-v1:'||owned.campaign_id::text FROM (SELECT c.campaign_id FROM crm_audience_v2.regular_delivery_campaign c JOIN public.campaigns p ON p.id=c.campaign_id CROSS JOIN crm_audience_v2.regular_worker_deployment d WHERE d.singleton AND c.enabled AND p.type::text='regular' AND p.messenger='email' AND p.attribs#>>'{crm,policy}'='crm-campaign-v1' AND p.attribs#>>'{crm,brand}' IN('fish','aristo') AND p.status::text IN('scheduled','running','paused') AND c.worker_sha256=d.worker_sha256 AND c.runtime_sha256=d.runtime_sha256) owned) ORDER BY x.dispatch_id LIMIT 4097) x))
) INTO after_state;

 f_after:=after_state->'function';
 IF after_state->'deployment' IS DISTINCT FROM target_deployment
 OR after_state->'controls' IS DISTINCT FROM target_controls
 OR after_state->'lease' IS DISTINCT FROM before_state->'lease'
 OR after_state->'selectionRuntime' IS DISTINCT FROM before_state->'selectionRuntime'
 OR after_state->'ownedRowState' IS DISTINCT FROM before_state->'ownedRowState'
 OR after_state->'preservedFunctionMetadata' IS DISTINCT FROM before_state->'preservedFunctionMetadata'
 OR after_state->'relationMetadata' IS DISTINCT FROM before_state->'relationMetadata'
 OR after_state->'mutationTriggers' IS DISTINCT FROM before_state->'mutationTriggers'
 OR after_state->'ownedActiveCampaignIds' IS DISTINCT FROM ids
 OR (f_after-'prosrc') IS DISTINCT FROM (f_before-'prosrc')
 OR md5(f_after->>'prosrc') IS DISTINCT FROM target_md5
 OR after_state#>>'{queryConstraint,name}' IS DISTINCT FROM constraint_name
 OR after_state#>>'{queryConstraint,expression}' IS DISTINCT FROM
  '(query_sha256 = '||quote_literal(plan->>'targetQuerySha256')||'::text)'
 OR ((after_state->'queryConstraint')-ARRAY['definition','expression']) IS DISTINCT FROM
    ((before_state->'queryConstraint')-ARRAY['definition','expression'])
 OR after_state#>>'{queryConstraint,validated}' IS DISTINCT FROM 'true'
 OR (admission->>'expiresAt')::timestamptz<=clock_timestamp() THEN
  RAISE EXCEPTION 'COHERENT_TRANSITION_ATOMIC_POST_FENCE_FAILED';
 END IF;
END $coherent_transition$;
